# Name of the application, used in logging and documentation
PROJECT_NAME=Feature Roadmap Portal

# Prefix for versioned API routes
API_PREFIX=/api/v1

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Name of the MongoDB database to use
DATABASE_NAME=feature_roadmap_portal

# Secret key used to sign JWT access tokens
JWT_SECRET=change-this-to-a-long-random-secret-value

# Secret key used to sign JWT refresh tokens
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret-value

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime, in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# URL of the frontend application, used for CORS configuration
FRONTEND_URL=http://localhost:5173

# Email verification token lifetime, in hours
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Password reset token lifetime, in minutes
PASSWORD_RESET_EXPIRE_MINUTES=30

# Application environment; when "development", auth endpoints include raw
# verification/reset tokens in their responses for local testing
APP_ENV=development
